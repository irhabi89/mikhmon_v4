# Copy to .env and adjust. Values below are the defaults.
MIKHMON_DB_PATH=data/mikhmon.db
# Public base URL used by RouterOS on-login webhooks. No trailing slash.
# Leave empty to keep webhook disabled; the script fallback still records sales.
MIKHMON_PUBLIC_URL=
MIKHMON_ROUTER_TRANSPORT=native
MIKHMON_SYNC_WORKER=auto
MIKHMON_SYNC_BATCH=500
MIKHMON_SYNC_RANGE_ROWS=2000
MIKHMON_SYNC_LOOKBACK_MONTHS=36
MIKHMON_LOG_LEVEL=info
# Path to the PHP CLI binary used by the background sync worker (empty = auto)
MIKHMON_PHP_CLI=
